[
  {
    "id": "page-splash",
    "route": "/splash",
    "appBar": {}
  },
  {
    "id": "page-splash-carousel",
    "route": "/splash-carousel",
    "appBar": {}
  },
  {
    "id": "page-auth-login",
    "route": "/auth/login",
    "appBar": {
      "id": "auth-login-appbar",
      "type": "appBar",
      "props": {
        "title": "تسجيل الدخول",
        "elevation": 0
      }
    }
  },
  {
    "id": "page-auth-otp-reset",
    "route": "/auth/otp-reset",
    "appBar": {
      "id": "auth-otp-appbar",
      "type": "appBar",
      "props": {
        "title": "تأكيد الرمز",
        "elevation": 0
      }
    }
  },
  {
    "id": "page-home",
    "route": "/home",
    "appBar": {
      "id": "home-appbar",
      "type": "appBar",
      "props": {
        "title": "SOOQ",
        "titleAlign": "center",
        "elevation": 0,
        "showMenu": true,
        "menuIcon": "menu",
        "menuAction": {
          "type": "openDrawer"
        },
        "trailingIcon": "notifications",
        "trailingAction": {
          "type": "navigate",
          "route": "/notifications",
          "navigation_type": "push"
        },
        "foregroundColor": "#0F172A"
      },
      "style": {
        "background": "#FFFFFF"
      }
    }
  },
  {
    "id": "page-categories",
    "route": "/categories",
    "appBar": {
      "id": "categories-appbar",
      "type": "appBar",
      "props": {
        "title": "التصنيفات",
        "height": 62,
        "elevation": 0
      },
      "style": {
        "background": "#FFFFFF"
      }
    }
  },
  {
    "id": "page-products",
    "route": "/products",
    "appBar": {
      "id": "products-appbar",
      "type": "appBar",
      "props": {
        "title": "المنتجات",
        "elevation": 0
      },
      "style": {
        "background": "#FFFFFF"
      }
    }
  },
  {
    "id": "page-product-details",
    "route": "/product/details/:productId",
    "appBar": {
      "id": "product-details-appbar",
      "type": "appBar",
      "props": {
        "title": "تفاصيل المنتج",
        "backgroundColor": "#00000000",
        "elevation": 0,
        "foregroundColor": "#FFFFFF",
        "showCartIcon": true,
        "cartBadgePath": "cart.itemCount",
        "cartAction": {
          "type": "navigate",
          "route": "/cart"
        },
        "trailingIconActive": "favorite",
        "trailingIconInactive": "favorite_outline",
        "trailingIconActivePath": "wishlist.isCurrentProductFavorite",
        "trailingActiveColor": "#E11D48",
        "trailingAction": {
          "type": "cubitCall",
          "cubit": "wishlist",
          "method": "toggle",
          "params": {
            "productId": {
              "source": "routeparams",
              "field": "productId"
            },
            "productTitle": {
              "source": "datacontext",
              "field": "requests.product-detail.data.name"
            },
            "thumbnailUrl": {
              "source": "datacontext",
              "field": "requests.product-detail.data.primaryImageUrl"
            },
            "displayPrice": {
              "source": "datacontext",
              "field": "requests.product-detail.data.displayPrice"
            }
          }
        }
      }
    }
  },
  {
    "id": "page-category-products",
    "route": "/categories/:categorySlug/products",
    "appBar": {
      "id": "category-products-appbar",
      "type": "appBar",
      "props": {
        "title": "منتجات القسم",
        "elevation": 0
      },
