        "title": "سلة التسوق",
        "titleAlign": "center",
        "height": 62,
        "elevation": 0,
        "foregroundColor": "#0F172A",
        "backgroundGradient": true,
        "trailingIcon": "delete_sweep",
        "trailingAction": {
          "type": "cubitCall",
          "cubit": "cart",
          "method": "clear"
        }
      },
      "style": {
