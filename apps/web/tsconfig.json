{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/core": ["../../packages/editor-packages/core/index.ts"],
      "@/core/*": ["../../packages/editor-packages/core/*"],
      "@/plugin-heading-analyzer": [
        "../../packages/editor-packages/plugin-heading-analyzer/index.ts"
      ],
      "@/plugin-heading-analyzer/*": [
        "../../packages/editor-packages/plugin-heading-analyzer/*"
      ],
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
