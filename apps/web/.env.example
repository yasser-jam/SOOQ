# =============================================================================
# SOOQ-Front (web) — environment template
# Copy this file to `.env.local` and fill in the values you need.
# `.env*` files (except `.env.example`) are gitignored.
# =============================================================================

# Backend API base URL (required)
# Local Spring Boot: http://localhost:8081/api/v1
# Production: https://api.example.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1

# Post-onboarding hard-navigate target for the MERCHANT (optional, recommended).
# After CreateStoreFlow / OTP login finishes, the merchant is redirected to
# `${NEXT_PUBLIC_STOREFRONT_BASE}/${slug}` — i.e. their dashboard at
# `/store/[slug]` after the multi-tenant routing refactor. The customer-facing
# storefront lives at `/shop/[slug]` and uses a separate URL builder.
# Local dev (merchant dashboard): http://localhost:3000/store
# Production (separate merchant app): https://app.shopengine.com
NEXT_PUBLIC_STOREFRONT_BASE=http://localhost:3000/store

# Google OAuth client ID (optional).
# Enables the "Sign in with Google" button on /request-otp. Without it,
# the button quietly hides — useful when you don't want to configure
# Google credentials in dev.
# Get one from https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
