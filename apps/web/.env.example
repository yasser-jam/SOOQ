# =============================================================================
# SOOQ-Front (web) — environment template
# Copy this file to `.env.local` and fill in the values you need.
# `.env*` files (except `.env.example`) are gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API (REQUIRED when mock mode is off)
# -----------------------------------------------------------------------------
# Spring Boot REST root. The trailing path must be `/api/v1`.
# Local dev:   http://localhost:8081/api/v1
# Production:  https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=https://api.erteqa.me/api/v1


# -----------------------------------------------------------------------------
# Mock API mode (OPTIONAL — local / demo without Spring)
# -----------------------------------------------------------------------------
# When `true`, auth (merchant + customer OTP/Google), onboarding store
# settings, products, categories, tags, collections (admin + public), and
# storefront checkout are served from in-browser seeders (localStorage)
# via `api()` / `publicApi()`. This also powers the editor collection/
# product/tag pickers, preview, and the full `apps/store` buy flow without
# a Spring backend. All other endpoints still call `NEXT_PUBLIC_API_URL`.
# Demo OTP: phone +963999000111, code 123456
# Storefront slug (mock): demo-store
# After toggling on, hard-refresh once (or clear `sooq-mock-api-db`) so seed v6 loads
# (FakeStore catalog + tags + featured/sale collections + discount codes).
# NEXT_PUBLIC_USE_MOCK_API=true
NEXT_PUBLIC_USE_MOCK_API=false


# -----------------------------------------------------------------------------
# Merchant post-login redirect target (REQUIRED for production)
# -----------------------------------------------------------------------------
# After a merchant finishes onboarding (CreateStoreFlow), verifies their OTP
# (/verify-otp), or signs in with Google, the FE hard-navigates them to
# `${NEXT_PUBLIC_STOREFRONT_BASE}/${slug}` — which after the multi-tenant
# routing refactor is the merchant dashboard at `/store/[slug]`.
#
# IMPORTANT — name is legacy. Despite "STOREFRONT" in the name, this points
# at the MERCHANT DASHBOARD, NOT the customer-facing storefront. The customer
# storefront lives under `/shop/[slug]` and is reached separately.
#
# The value MUST end in `/store` (no trailing slash). Setting it to just the
# host root would land the merchant at `/${slug}` which is a 404.
#
# Local dev:   http://localhost:3000/store
# Production:  https://app.yourdomain.com/store
NEXT_PUBLIC_STOREFRONT_BASE=http://localhost:3000/store


# -----------------------------------------------------------------------------
# Google OAuth (OPTIONAL)
# -----------------------------------------------------------------------------
# Enables the "Sign in with Google" button on /request-otp. Leave empty to
# hide the button (useful for dev environments without Google credentials).
# Get a client ID from https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=744220592946-n9gumvcct55j80b0iqg4mqecosrsv6l0.apps.googleusercontent.com
