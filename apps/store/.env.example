# =============================================================================
# SOOQ Storefront (apps/store) — environment template
# Copy this file to `.env.local` and fill in the values you need.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API (REQUIRED when mock mode is off)
# -----------------------------------------------------------------------------
# Spring Boot REST root. Must end with `/api/v1`.
# Local:       http://localhost:8081/api/v1
# Production:  https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1

# -----------------------------------------------------------------------------
# Mock API mode (OPTIONAL — full storefront flow without Spring)
# -----------------------------------------------------------------------------
# When `true`, catalog GETs, customer OTP, and checkout POSTs are served from
# the shared in-browser seeder (`apps/web/lib/mock`, localStorage key
# `sooq-mock-api-db`) via `api()` / `publicApi()`.
#
# Demo credentials:
#   phone:    +963999000111
#   OTP:      123456
#   tenant:   demo-store  (or set NEXT_PUBLIC_TENANT_SLUG)
#
# After toggling on, hard-refresh once (or clear `sooq-mock-api-db`) so seed
# v3 loads (products, collections, orders).
# NEXT_PUBLIC_USE_MOCK_API=true
NEXT_PUBLIC_USE_MOCK_API=false

# Store slug sent with customer OTP request / verify.
# In mock mode the default is `demo-store` when unset.
# NEXT_PUBLIC_TENANT_SLUG=demo-store
