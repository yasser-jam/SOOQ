# =============================================================================
# SOOQ Store (apps/store) — environment template
# Copy this file to `.env.local` and fill in the values you need.
# =============================================================================

# Backend API root (must end with `/api/v1`)
NEXT_PUBLIC_API_URL=https://api.erteqa.me/api/v1

# Tenant UUID for unauthenticated storefront API calls (X-Tenant-Id header)
NEXT_PUBLIC_TENANT_SLUG=tmp-4624d73c8f49494cb8be2aedcb967e3a

# Media CDN base — relative image paths from the API are prefixed with this URL
NEXT_PUBLIC_MEDIA_URL=https://api.erteqa.me/media
